# If set, the sidebar uses Claude (opus-4-7) to pick which tool to invoke
# instead of the keyword-matching stub. Get a key from console.anthropic.com.
#
# WARNING: VITE_* env vars are inlined into the client bundle and visible
# to anyone who opens devtools. This is fine for local dev / demos.
# For production, run a backend proxy that holds the key.
VITE_ANTHROPIC_API_KEY=
