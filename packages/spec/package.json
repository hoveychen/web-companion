{
  "name": "@web-companion/spec",
  "version": "0.1.0",
  "description": "Schema, TypeScript types, and runtime validator for the Companion protocol — the JSON document at /.well-known/companion.json that declares a website's AI-operable tools and resources.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./companion.schema.json"
  },
  "files": [
    "dist",
    "companion.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run gen-schema",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen-schema": "tsx scripts/gen-schema.ts"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
